<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5e032d5a-e4bb-4088-8b2b-9d138110890c</UserSecretsId>

    <!-- The native launcher (bin/.../ManufacturerExtraction.Api.exe) is what a running instance
         locks on Windows, causing "dotnet build" to fail with MSB3027/MSB3026 whenever the app
         is still running from a previous "dotnet run". This project is only ever launched via
         `dotnet run` / `dotnet ManufacturerExtraction.Api.dll` (never by double-clicking the
         .exe), so the native launcher is not needed — disabling it stops that file from being
         produced at all, removing the lock conflict at its source instead of working around it
         each time. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="ExcelDataReader" Version="3.7.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>