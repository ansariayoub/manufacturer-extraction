  },
  "AzureOpenAI": {
    "Endpoint": "https://<your-openai-resource>.openai.azure.com",
    "ApiKey": "<your-key>",
    "DeploymentName": "gpt-5.2"
  },
  "Logging": {
    "LogLevel": { "Default": "Information" }
  },
  "AllowedHosts": "*"
}