{
  "ConnectionStrings": {
    "AzureSql": "Server=tcp:<your-server>.database.windows.net,1433;Database=<your-db>;User ID=<user>;Password=<password>;Encrypt=true;",
    "AzureBlobStorage": "<your-blob-connection-string>"
  },
  "AzureBlobStorage": {
    "ContainerName": "documents"
  },
  "AzureContentUnderstanding": {
    "Endpoint": "https://<your-resource>.cognitiveservices.azure.com",
